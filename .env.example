NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://tubir.kz

# Submission security
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SUBMISSION_HASH_SALT=replace-with-a-long-random-secret

# Admin access, comma-separated
ADMIN_EMAILS=admin@example.com

# Optional notifications for successful submissions
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUBMISSION_WEBHOOK_URL=

# Google Maps (optional). When set, /map renders a live Google map.
# Enable the "Maps JavaScript API" in Google Cloud Console and restrict
# the key to your domain (tubir.kz, tubir.vercel.app, localhost).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
